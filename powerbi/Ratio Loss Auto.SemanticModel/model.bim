                "    #\"En-têtes promus\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Type modifié\" = Table.TransformColumnTypes(#\"En-têtes promus\",{{\"\", Int64.Type}, {\"IDpol\", Int64.Type}, {\"Exposure\", type number}, {\"Area\", type text}, {\"VehPower\", Int64.Type}, {\"VehAge\", Int64.Type}, {\"DrivAge\", Int64.Type}, {\"BonusMalus\", Int64.Type}, {\"VehBrand\", type text}, {\"VehGas\", type text}, {\"Density\", Int64.Type}, {\"Region\", type text}, {\"ClaimTotal\", type number}, {\"ClaimNb\", Int64.Type}}),",
                "    #\"Colonnes supprimées\" = Table.RemoveColumns(#\"Type modifié\",{\"\"})",
                "in",
