          {
            "name": "Tranche_Age_Conducteur",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "\r",
              "SWITCH(\r",
              "    TRUE(),\r",
              "    Freq_Polices[DrivAge] <= 25, \"Jeune conducteur\",\r",
              "    Freq_Polices[DrivAge] <= 40, \"Confirmé\",\r",
              "    Freq_Polices[DrivAge] <= 60, \"Expérimenté\",\r",
              "    \"Senior\"\r",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "3cd1ef69-2cdf-40d0-9b20-202d96a77699",
            "sortByColumn": "Ordre_Age",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Tranche_Puissance",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "\r",
              "SWITCH(\r",
              "    TRUE(),\r",
              "    Freq_Polices[VehPower] <= 6, \"Faible\",\r",
              "    Freq_Polices[VehPower] <= 9, \"Moyenne\",\r",
              "    \"Élevée\"\r",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "5bd6d2b1-38fe-4206-9316-f96b1d0498ed",
            "sortByColumn": "Ordre_Puissance",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "A_Sinistre",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "IF(Freq_Polices[ClaimNb] > 0, \"Oui\", \"Non\")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "eba8289d-6852-42ad-8d0d-53aa6c6bacc5",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Tranche_BonusMalus",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "\r",
              "SWITCH(\r",
              "    TRUE(),\r",
              "    Freq_Polices[BonusMalus] <= 79, \"Bonus fort\",\r",
              "    Freq_Polices[BonusMalus] <= 99, \"Bonus léger\",\r",
              "    Freq_Polices[BonusMalus] = 100, \"Neutre\",\r",
              "    Freq_Polices[BonusMalus] <= 150, \"Malus\",\r",
              "    \"Malus fort\"\r",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "7176d035-ff88-4f2b-9b88-db173fd8d50b",
            "sortByColumn": "Ordre_BonusMalus",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Ordre_Age",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    Freq_Polices[DrivAge] <= 25, 1,",
              "    Freq_Polices[DrivAge] <= 40, 2,",
              "    Freq_Polices[DrivAge] <= 60, 3,",
              "    4",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "447a282e-9143-40c5-9731-3ecc4dcb4e80",
            "summarizeBy": "none",
