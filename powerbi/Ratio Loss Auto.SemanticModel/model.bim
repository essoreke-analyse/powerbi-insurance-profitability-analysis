                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "dataType": "double",
            "lineageTag": "539d8387-f0c0-4ec4-afd0-88e362bf2d6d",
            "sourceColumn": "ClaimAmount",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "05867dc0-1c0d-4ad1-b38b-6bc2ba6b54b6",
        "partitions": [
          {
            "name": "Sev_Sinistres",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\Users\\micho\\Downloads\\projet_loss_ratio\\freMTPL2sev.csv\"),[Delimiter=\",\", Columns=2, Encoding=1252, QuoteStyle=QuoteStyle.None]),",
                "    #\"En-têtes promus\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Type modifié\" = Table.TransformColumnTypes(#\"En-têtes promus\",{{\"IDpol\", Int64.Type}, {\"ClaimAmount\", type number}})",
                "in",
                "    #\"Type modifié\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Mesures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Colonne 1",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "c44df1d2-a7e5-40fa-93fb-27ec834777bd",
            "sourceColumn": "Colonne 1",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "2ff7daa9-f0a9-41fa-adaa-595ba1cf5234",
        "measures": [
          {
            "name": "Cout_Moyen_Sinistre",
            "expression": "DIVIDE([Cout_Total_Sinistres], [Nb_Sinistres])",
            "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
            "lineageTag": "0588732e-23d9-4899-b369-d9a1e55587eb"
          },
          {
            "name": "Cout_Total_Sinistres",
            "expression": "SUM(Freq_Polices[ClaimTotal])",
            "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
            "lineageTag": "b6ebff19-d999-4bc6-83ee-6c3027268208"
          },
          {
            "name": "Exposition_Totale",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM(Freq_Polices[Exposure])",
            "lineageTag": "a6cdcdda-2d8d-4c18-85f1-cf939bd51e45"
          },
          {
            "name": "Frequence_Sinistres",
            "expression": "DIVIDE([Nb_Sinistres], [Exposition_Totale])",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "1aff1e6e-168a-4764-a22f-a0486b3dfb40"
          },
          {
            "name": "Nb_Polices",
            "expression": "COUNTROWS(Freq_Polices)",
            "formatString": "0",
            "lineageTag": "7cbd30e3-2f4c-4be6-8e11-e2ea6f969cc7"
          },
          {
            "name": "Nb_Sinistres",
            "expression": "SUM(Freq_Polices[ClaimNb])",
            "formatString": "0",
            "lineageTag": "835463b5-6d33-4239-953e-3472fdd39149"
          },
          {
            "name": "Prime_Pure_Unitaire_Globale",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE([Cout_Total_Sinistres], [Exposition_Totale]),",
              "    ALL(Freq_Polices)",
              ")"
            ],
            "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
            "lineageTag": "5df870ce-1694-4419-aa0b-0ac996304913"
          },
          {
            "name": "Prime_Totale_Simulee",
            "expression": "[Prime_Pure_Unitaire_Globale] * [Exposition_Totale]",
            "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
            "lineageTag": "6bbf504f-3e63-41fb-8ddf-bf9704ee986c"
          },
          {
            "name": "Indice prime pure",
            "description": "Coût des sinistres par année d'exposition du segment, divisé par celui du portefeuille (100 % = moyenne). Ce n'est pas une rentabilité : les primes réelles ne sont pas dans les données.",
            "displayFolder": "1. Indices",
            "expression": "DIVIDE([Cout_Total_Sinistres], [Prime_Totale_Simulee])",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "95cd97bf-4b1d-4a1e-9b9b-d4d7faeedbb0"
          },
          {
            "name": "Seuil écrêtement",
            "description": "Seuil des sinistres graves : 99,5e percentile du montant des sinistres. Au-delà, un sinistre est plafonné à ce montant.",
            "displayFolder": "2. Sinistres graves",
            "expression": [
              "CALCULATE(",
              "    PERCENTILEX.INC(FILTER(Sev_Sinistres, NOT ISBLANK(RELATED(Freq_Polices[IDpol]))), Sev_Sinistres[ClaimAmount], 0.995),",
              "    REMOVEFILTERS(Sev_Sinistres),",
              "    REMOVEFILTERS(Freq_Polices)",
              ")"
            ],
            "formatString": "#,0\\ \"€\";-#,0\\ \"€\";#,0\\ \"€\"",
            "lineageTag": "bdc77393-49b0-45be-aedd-b90acff73a0a"
          },
          {
            "name": "Coût total écrêté",
            "description": "Coût des sinistres, chaque sinistre étant plafonné au seuil d'écrêtement.",
            "displayFolder": "2. Sinistres graves",
            "expression": [
              "VAR Seuil = [Seuil écrêtement]",
              "RETURN",
              "    SUMX(FILTER(Sev_Sinistres, NOT ISBLANK(RELATED(Freq_Polices[IDpol]))), MIN(Sev_Sinistres[ClaimAmount], Seuil))"
            ],
            "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
            "lineageTag": "09cb0f7c-bc5c-4782-a548-1122def3bea6"
          },
          {
            "name": "Coût moyen écrêté",
            "description": "Coût moyen par sinistre après écrêtement des sinistres graves.",
            "displayFolder": "2. Sinistres graves",
            "expression": "DIVIDE([Coût total écrêté], COUNTROWS(FILTER(Sev_Sinistres, NOT ISBLANK(RELATED(Freq_Polices[IDpol])))))",
            "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
            "lineageTag": "70aa3a69-28ce-4b1a-ba39-2c71022e330b"
          },
          {
            "name": "Indice prime pure écrêtée",
            "description": "Indice de prime pure calculé avec les sinistres graves écrêtés (100 % = moyenne). Il n'est plus tiré par un ou deux sinistres exceptionnels.",
            "displayFolder": "1. Indices",
            "expression": [
              "VAR PP_Segment = DIVIDE([Coût total écrêté], [Exposition_Totale])",
              "VAR PP_Portefeuille =",
              "    CALCULATE(",
              "        DIVIDE([Coût total écrêté], [Exposition_Totale]),",
              "        REMOVEFILTERS(Freq_Polices),",
              "        REMOVEFILTERS(Sev_Sinistres)",
              "    )",
              "RETURN",
              "    DIVIDE(PP_Segment, PP_Portefeuille)"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "6fd407ae-05cf-4601-aa67-5bf289226241"
          },
          {
            "name": "Nb sinistres graves",
            "description": "Nombre de sinistres au-dessus du seuil d'écrêtement.",
            "displayFolder": "2. Sinistres graves",
            "expression": [
              "VAR Seuil = [Seuil écrêtement]",
              "RETURN",
              "    COUNTROWS(FILTER(FILTER(Sev_Sinistres, NOT ISBLANK(RELATED(Freq_Polices[IDpol]))), Sev_Sinistres[ClaimAmount] > Seuil))"
            ],
            "formatString": "0",
            "lineageTag": "7fc31e94-1d60-494f-abfe-3de89268ece8"
          },
          {
            "name": "Part du coût au-dessus du seuil",
            "description": "Part du coût total qui dépasse le seuil d'écrêtement.",
            "displayFolder": "2. Sinistres graves",
            "expression": [
              "VAR Seuil = [Seuil écrêtement]",
              "VAR Sinistres = FILTER(Sev_Sinistres, NOT ISBLANK(RELATED(Freq_Polices[IDpol])))",
              "RETURN",
              "    DIVIDE(",
              "        SUMX(Sinistres, MAX(Sev_Sinistres[ClaimAmount] - Seuil, 0)),",
              "        SUMX(Sinistres, Sev_Sinistres[ClaimAmount])",
              "    )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "c85f23bb-0d46-467b-89a5-5ce4aab648df"
          },
          {
            "name": "Fréquence IC bas",
            "description": "Borne basse de l'intervalle de confiance à 95 % de la fréquence (approximation de Poisson).",
            "displayFolder": "3. Crédibilité",
            "expression": "DIVIDE(MAX([Nb_Sinistres] - 1.96 * SQRT([Nb_Sinistres]), 0), [Exposition_Totale])",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "baf21f04-0e13-490b-a95c-84ff7fae5cc7"
          },
          {
            "name": "Fréquence IC haut",
            "description": "Borne haute de l'intervalle de confiance à 95 % de la fréquence (approximation de Poisson).",
            "displayFolder": "3. Crédibilité",
            "expression": "DIVIDE([Nb_Sinistres] + 1.96 * SQRT([Nb_Sinistres]), [Exposition_Totale])",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "431e3a1e-a8bb-4b91-a947-669cafbeaabd"
          },
          {
            "name": "Crédibilité",
            "description": "Signale les segments où les résultats reposent sur trop peu de sinistres.",
            "displayFolder": "3. Crédibilité",
            "expression": [
              "IF(",
              "    ISBLANK([Nb_Polices]),",
              "    BLANK(),",
              "    IF([Nb_Sinistres] < 50, \"⚠ moins de 50 sinistres\", \"OK\")",
              ")"
            ],
            "lineageTag": "52d00b1e-bdfd-4e47-8893-07a8d7e8ec30"
          },
          {
            "name": "Part du coût des sinistres graves",
            "description": "Part du coût total représentée par les sinistres graves (au-delà du seuil d'écrêtement).",
            "displayFolder": "2. Sinistres graves",
            "expression": [
              "VAR Seuil = [Seuil écrêtement]",
              "VAR Sinistres = FILTER(Sev_Sinistres, NOT ISBLANK(RELATED(Freq_Polices[IDpol])))",
              "RETURN",
              "    DIVIDE(",
              "        SUMX(FILTER(Sinistres, Sev_Sinistres[ClaimAmount] > Seuil), Sev_Sinistres[ClaimAmount]),",
              "        SUMX(Sinistres, Sev_Sinistres[ClaimAmount])",
              "    )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "19481ea9-3021-44eb-b210-4f858237f700"
          }
        ],
        "partitions": [
          {
            "name": "_Mesures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Colonne 1\" = _t]),",
                "    #\"Type modifié\" = Table.TransformColumnTypes(Source,{{\"Colonne 1\", type text}})",
                "in",
                "    #\"Type modifié\""
              ],
              "type": "m"
            }
          }
        ]
      },
