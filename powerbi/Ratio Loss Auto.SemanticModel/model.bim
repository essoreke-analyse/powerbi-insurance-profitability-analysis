            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "IDpol",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "ab5adf89-65a6-4d24-a7f3-a15c82c0f1ac",
            "sourceColumn": "IDpol",
            "summarizeBy": "none"
          },
          {
            "name": "ClaimAmount",
            "annotations": [
              {
