          },
          {
            "name": "Ordre_Puissance",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    Freq_Polices[VehPower] <= 6, 1,",
              "    Freq_Polices[VehPower] <= 9, 2,",
              "    3",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "1b791baf-531f-42cb-90f8-9bbd26102471",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Ordre_BonusMalus",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    Freq_Polices[BonusMalus] <= 79, 1,",
              "    Freq_Polices[BonusMalus] <= 99, 2,",
              "    Freq_Polices[BonusMalus] = 100, 3,",
              "    Freq_Polices[BonusMalus] <= 150, 4,",
              "    5",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "e2aacd6f-d590-4a53-84f3-df55d73440f5",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Région",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "SWITCH(",
              "    Freq_Polices[Region],",
              "    \"R11\", \"Île-de-France\",",
              "    \"R21\", \"Champagne-Ardenne\",",
              "    \"R22\", \"Picardie\",",
              "    \"R23\", \"Haute-Normandie\",",
              "    \"R24\", \"Centre\",",
              "    \"R25\", \"Basse-Normandie\",",
              "    \"R26\", \"Bourgogne\",",
              "    \"R31\", \"Nord-Pas-de-Calais\",",
              "    \"R41\", \"Lorraine\",",
              "    \"R42\", \"Alsace\",",
              "    \"R43\", \"Franche-Comté\",",
              "    \"R52\", \"Pays de la Loire\",",
              "    \"R53\", \"Bretagne\",",
              "    \"R54\", \"Poitou-Charentes\",",
              "    \"R72\", \"Aquitaine\",",
              "    \"R73\", \"Midi-Pyrénées\",",
              "    \"R74\", \"Limousin\",",
              "    \"R82\", \"Rhône-Alpes\",",
              "    \"R83\", \"Auvergne\",",
              "    \"R91\", \"Languedoc-Roussillon\",",
              "    \"R93\", \"Provence-Alpes-Côte d'Azur\",",
              "    \"R94\", \"Corse\",",
              "    Freq_Polices[Region]",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "0f1ee9ac-9414-46da-ac25-e7ea849ec194",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
